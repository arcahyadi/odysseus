# Odysseus UI — Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================================
# LLM Configuration
# ============================================================

# Primary LLM host (default: localhost)
LLM_HOST=localhost

# Additional LLM hosts, comma-separated (for model discovery)
# Use hostnames/IPs only; Odysseus scans common serve ports, including Ollama's 11434.
# LLM_HOSTS=llm-host.local,backup-llm.local

# Optional Ollama base URL. In Docker, host Ollama is usually reachable here
# when started with OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional LM Studio URL. In Docker, host LM Studio is reachable here
# when LM Studio is set to serve on all interfaces (0.0.0.0).
# LM_STUDIO_URL=http://host.docker.internal:1234

# OpenAI API key (only needed if using OpenAI models).
# Do not commit real keys. Keep this commented until needed.
# OPENAI_API_KEY=your_openai_api_key_here

# ── AgentOS ZenRouter — OpenCode subscription key (moteur principal) ──────────
# Obtenir sur opencode.ai — active le routing intelligent vers Zen API.
# Sans cette clé, Odysseus fonctionne normalement avec ses endpoints configurés.
# OPENCODE_API_KEY=sk-your-opencode-key-here

# Research service LLM endpoint
# RESEARCH_LLM_ENDPOINT=http://localhost:8000/v1/chat/completions

# Extra CA bundle for LLM providers whose TLS chain isn't in the default
# trust store. Layered ON TOP of the system / certifi bundle — verification
# stays on for every host, the trust set just gets larger. Useful for:
#   - GigaChat / Sber (Russian Trusted Root CA): without this the endpoint
#     shows offline with CERTIFICATE_VERIFY_FAILED — self-signed certificate
#     in certificate chain.
#   - On-premise / corporate LLM gateways with an internal CA.
# Point at a PEM file containing the missing root(s).
# LLM_CA_BUNDLE=/etc/odysseus/ca/extra-roots.pem

# ============================================================
# Search & Web
# ============================================================

# SearXNG instance URL (self-hosted, for web search).
# Docker Compose overrides this to http://searxng:8080 for in-network access.
SEARXNG_INSTANCE=http://localhost:8080

# Optional SearXNG cookie/CSRF secret. If blank, Docker generates one on first boot
# and stores it in the searxng-data volume.
# SEARXNG_SECRET=

# ============================================================
# Database
# ============================================================

# SQLite (default)
# DATABASE_URL=sqlite:///./data/app.db

# PostgreSQL (production profile) — requires: docker compose --profile production up -d
# DATABASE_URL=postgresql+asyncpg://odysseus:odysseus@postgres:5432/odysseus

# PostgreSQL password for the bundled pgvector container (Agent A20)
# POSTGRES_PASSWORD=odysseus

# ============================================================
# Data directory
# ============================================================
# Move everything that lives under data/ - settings, sessions, database, auth,
# cache, uploads, etc. - to another path:
# ODYSSEUS_DATA_DIR=/path/to/data

# ============================================================
# Auth & Security
# ============================================================

# Enable authentication (default: true)
# AUTH_ENABLED=true

# Host bind address and port for the Odysseus web UI in Docker Compose.
# Keep APP_BIND on loopback unless you intentionally want LAN/reverse-proxy access.
# APP_BIND=127.0.0.1
# Change this if another local service already uses 7000 (macOS AirPlay often does).
# APP_PORT=7000

# Development-only auth bypass for loopback requests.
# Keep false for Docker, LAN, reverse proxy, and any shared deployment.
# LOCALHOST_BYPASS=false

# Mark session cookies Secure. Set true when Odysseus is served through HTTPS
# by a trusted reverse proxy or private access gateway.
# SECURE_COOKIES=true

# Optional: pre-seed the first admin password during setup.
# Do not commit a real password.
# ODYSSEUS_ADMIN_PASSWORD=change_me_before_first_boot

# CORS allowed origins (default: localhost-only; restrict to your public origin in production)
# ALLOWED_ORIGINS=http://localhost:7000,http://localhost:8000

# ============================================================
# ChromaDB (vector store)
# ============================================================

# ChromaDB service host.
# Manual host run: localhost:8100 when using `docker run -p 8100:8000 chromadb/chroma`.
# Docker Compose overrides these to chromadb:8000 for in-network access.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Docker Compose host-port bind addresses for bundled services.
# Defaults are loopback-only for safety. To expose ntfy only on Tailscale,
# set NTFY_BIND to your host's Tailscale IP and update NTFY_BASE_URL.
# CHROMADB_BIND=127.0.0.1
# NTFY_BIND=127.0.0.1
# NTFY_BASE_URL=http://localhost:8091
# Example:
# NTFY_BIND=100.x.y.z
# NTFY_BASE_URL=http://100.x.y.z:8091

# ============================================================
# RAG / Embeddings
# ============================================================

# Embedding API endpoint (OpenAI-compatible /v1/embeddings)
# Default: http://{LLM_HOST}:11434/v1/embeddings (ollama)
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Embedding API key (if there's one)
# EMBEDDING_API_KEY=embedding_api_key_here

# Embedding model name (must be available at the endpoint above)
# EMBEDDING_MODEL=all-minilm:l6-v2

# Local fallback embedding model (used when no HTTP embedding API is available)
# Uses fastembed (ONNX) — downloads model on first run (~50MB)
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=  # defaults to ~/.cache/fastembed

# ============================================================
# Misc
# ============================================================

# Cleanup interval in hours (default: 24)
# CLEANUP_INTERVAL_HOURS=24

# In-process email pollers (default: on). Set to 0 if you're driving
# polling from cron / systemd via `scripts/odysseus-mail poll-scheduled`
# and `scripts/odysseus-mail poll-summary`, otherwise both schedulers
# race on the same SQLite.
# ODYSSEUS_INPROCESS_POLLERS=1

# In-process scheduled-task runner (default: on). Set to 0 to let an
# external driver fire scheduled tasks. Calendar reminders are
# frontend-driven (polling /api/notes from the browser) so no gate is
# needed there.
# ODYSSEUS_INPROCESS_TASKS=1

# Host used by the built-in "run_script" scheduled-task action.
# Empty/local/localhost runs scripts on the app host. Set to an SSH host alias
# if you intentionally want scheduled scripts to run remotely.
# ODYSSEUS_SCRIPT_HOST=localhost

# Chat / agent attachment size cap in bytes (default: 10 MB).
# Raise this for local installs that need larger PDFs or text documents.
# Example: 52428800 = 50 MB.
# ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=10485760

# Other per-feature upload size caps in bytes. All are validated and optional;
# defaults shown. An invalid value (non-integer or < 1) fails fast at startup.
# ODYSSEUS_GALLERY_UPLOAD_MAX_BYTES=104857600            # gallery image upload (100 MB)
# ODYSSEUS_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400   # gallery transform input (25 MB)
# ODYSSEUS_MEMORY_IMPORT_MAX_BYTES=10485760              # memory import file (10 MB)
# ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=26214400            # personal document upload (25 MB)
# ODYSSEUS_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=26214400       # email compose attachment (25 MB)
# ODYSSEUS_STT_MAX_AUDIO_BYTES=26214400                  # speech-to-text audio (25 MB)
# ODYSSEUS_ICS_MAX_BYTES=10485760                        # calendar .ics import (10 MB)

# ============================================================
# GPU support (Docker Compose)
# ============================================================
# Pass the host GPU into the odysseus container. Default (unset) = CPU.
# COMPOSE_FILE is a native `docker compose` feature: a colon-separated
# list of files merged left-to-right. Pick ONE GPU line below, or leave
# all commented for CPU.
#
# NVIDIA (requires nvidia-container-toolkit + `nvidia-ctk runtime
# configure --runtime=docker` on the host):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
# COMPOSE_FILE=docker-compose.yml;docker/gpu.nvidia.yml    #(Windows)
#
# AMD ROCm (requires ROCm drivers on the host and the GID of the render group):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml
# Find the render GID with: getent group render | cut -d: -f3
# RENDER_GID=989
#
# These overlays only expose the GPU devices. The slim Odysseus image
# still needs CUDA/ROCm userspace via Cookbook -> Dependencies (vLLM,
# llama-cpp-python, etc.) before models can actually serve on GPU.

# --- Orchestration (Milestone 2/3) ---------------------------------------
# Destructive command gate. ON by default: catastrophic shell commands
# (rm -rf, fork bomb, mkfs, dd, drop database, ...) are blocked at execution.
# Set to "off" to disable (log-only, legacy behavior).
ODYSSEUS_DESTRUCTIVE_GATE=on

# M3.0 phase bridge. OFF by default: the live loop does not enforce phase-lock.
# Set to "on" to let stream_agent_loop set a phase per round (activates phase-lock live).
ODYSSEUS_PHASE_TRACKER=on

# M3.4 governance ancestry. OFF by default: the live loop records no ancestry.
# When "on" AND the run carries an orchestrated goal context (project_id), the
# loop creates one GoalTask with its mission>goal>project>task ancestry_path at
# MEMORY_OBSERVE. Plain chat turns (no project_id) always write nothing.
ODYSSEUS_GOVERNANCE_ANCESTRY=off

# P5 progressive disclosure. ON by default (Palier 0): the tool surface visible to
# the agent is narrowed by phase + risk instead of being dumped in full every round.
# Set to "off" to expose the whole catalogue at all times.
ODYSSEUS_PROGRESSIVE_DISCLOSURE=on

# P19 memory impact verification. ON by default (Palier 0): only facts that actually
# change future answers are persisted, instead of every observed string.
# Set to "off" to store observations verbatim.
ODYSSEUS_MEMORY_IMPACT=on

# M3.2 Trinité checkpoint. OFF by default: the live loop persists no checkpoint.
# When "on", the loop writes ONE post-round record (session_id, run_id, final
# metrics summary, outcome) into the native Obsidian memory leg at MEMORY_OBSERVE.
# Best-effort: any vault fault is swallowed and never breaks the loop.
ODYSSEUS_CHECKPOINT=on

# M3.1 advisory model routing. OFF by default. When "on", the live loop logs the
# intent + the model the ModelRouter would suggest — advisory only, never
# overrides the user's chosen model.
ODYSSEUS_MODEL_ROUTER=on

# M3.2 RAG hybrid ranking. OFF by default → the shipped 0.7·vector + 0.3·keyword
# blend. When "on", RAG search re-ranks candidates with Reciprocal Rank Fusion
# (pure-vector ranking fused with BM25 lexical ranking).
ODYSSEUS_RRF_FUSION=off

# M3 Zen→ModelEndpoint. OFF by default → Zen routing turns on only via
# OPENCODE_API_KEY (unchanged). Set to "1" to also enable Zen from a registered
# native ModelEndpoint (host opencode.ai) when no env key is set — the DB row
# then supplies the base URL + key. Chat path is byte-identical when unset.
ODYSSEUS_ZEN_FROM_ENDPOINT=off

# M3.3 autoeval keep/revert. OFF by default: the live loop never reverts.
# When "on", after the verifier subagent runs, apply_autoeval reverts the last
# change (git reset --hard) only on non-empty verifier reasons OR drift=HIGH.
# Destructive — leave OFF unless you want autonomous self-correction.
ODYSSEUS_AUTOEVAL=on

# AUTOEVAL destructive execution. OFF by default, and deliberately SEPARATE from
# ODYSSEUS_AUTOEVAL above. AUTOEVAL decides "keep" or "revert" and reports it;
# this switch is the only thing that lets a decided revert actually run
# `git reset --hard`. Leave OFF everywhere except a sandbox/worktree you own:
# a real reset destroys every uncommitted byte in the tree the process runs in.
ODYSSEUS_AUTOEVAL_ALLOW_RESET=off

# M3.X unified token accounting. OFF by default: token usage recorded as before.
# When "on", traces/budgets/metrics are reconciled per correlation run_id into a
# single bounded writer. Accounting-only; no behavioural change to the loop.
ODYSSEUS_UNIFIED_TOKENS=on

# M3.5 in-process channel adapters. Both OFF by default: no adapter is woken and
# startup is byte-identical. Set to "on"/"1" to wake the Discord / Telegram
# adapter in-process (requires the matching *_BOT_TOKEN below).
ODYSSEUS_INPROCESS_DISCORD=off
ODYSSEUS_INPROCESS_TELEGRAM=off

# M3.5 channel agent reply round-trip. OFF by default: an inbound channel
# message only fires its trigger event (byte-identical to before). When "on",
# the inbound handler additionally runs the native one-shot agent on the message
# and replies to the sender. Independent of the adapter gates above.
ODYSSEUS_CHANNEL_AGENT_REPLY=off

# Obsidian read/search MCP server. OFF by default: not registered, startup
# byte-identical. When "on"/"1", the built-in stdio MCP server exposes
# list_notes/get_note/search_notes over the vault (see OBSIDIAN_VAULT_PATH in
# the "Obsidian second-brain" section below). The vault write leg is handled by
# the native checkpoint bridge, not this server.
ODYSSEUS_OBSIDIAN_MCP=off

# Graphify semantic knowledge graph MCP server. OFF by default: not registered,
# startup byte-identical. When "on"/"1", the built-in stdio MCP server exposes
# graphify_analyze/graphify_search/graphify_explain/graphify_status for semantic
# code analysis — 3rd leg of the Trinité (CBM structure + Graphify semantics +
# Obsidian memory). Requires: pip install graphifyy OR Docker profile.
# Activate with: docker compose --profile knowledge up -d
ODYSSEUS_GRAPHIFY=off

# Agent catalog (.opencode/agents/*.md). OFF by default: the 12 specialized
# GSD agents are not loaded at startup. When "on"/"1", agents are parsed and
# exposed via GET /api/agents. Startup byte-identical when OFF.
ODYSSEUS_AGENT_CATALOG=off

# ── M4 Agent Dispatch — per-agent kill-switches (all OFF by default) ──
# Each switch activates one .opencode agent at its canonical phase.
# When OFF → loop is byte-identical. When ON → agent fires as async background
# task at its phase. Agents never break the loop (best-effort, failures logged).
#
# Phase CLASSIFY → constitution (pre-flight 10 invariants check)
ODYSSEUS_AGENT_CONSTITUTION=off
# Phase PLAN → gsd-planner + gsd-researcher (planning & research)
ODYSSEUS_AGENT_PLANNER=off
ODYSSEUS_AGENT_RESEARCHER=off
# Phase BUILD → gsd-executor (implements tasks step by step)
ODYSSEUS_AGENT_EXECUTOR=off
# Phase BUILD (on failure) → gsd-debugger (systematic debugging)
ODYSSEUS_AGENT_DEBUGGER=off
# Phase QUALITY → debate-5-personas + security-audit (pre-build validation)
ODYSSEUS_AGENT_DEBATE=off
ODYSSEUS_AGENT_SECURITY=off
# Phase AUTOEVAL → gsd-verifier + edge-case-gen (verification & test gen)
ODYSSEUS_AGENT_VERIFIER=off
ODYSSEUS_AGENT_EDGECASE=off
# Phase MEMORY_OBSERVE → gsd-roadmapper (update roadmap/state)
ODYSSEUS_AGENT_ROADMAPPER=off
# Tool agents (explicit /design invocation only, not phase-tied)
ODYSSEUS_AGENT_DESIGN_EXTRACT=off
ODYSSEUS_AGENT_OPEN_DESIGN=off

# ============================================================
# Storage Paths (Docker Compose)
# ============================================================

# APP_DATA_DIR=./data
# APP_LOGS_DIR=./logs

# ============================================================
# gVisor Sandbox (Optional)
# ============================================================
# gVisor provides kernel-level isolation for MCP containers.
# Install: https://gvisor.dev/docs/user_guide/install/
# Then set ODYSSEUS_GVISOR=on to enable runsc for MCP services.
# ODYSSEUS_GVISOR=off
# ODYSSEUS_GVISOR_RUNTIME=runsc  # Set to 'runc' to disable

# ============================================================
# Docker Compose — optional service profiles
# ============================================================
# Core services start by default: odysseus, chromadb, searxng, ntfy, kroki,
# kroki-mermaid, serena-mcp.
#
# Optional profiles (append --profile <name> to docker compose up):
#   --profile scrapling       Scrapling adaptive web scraper (port 8800)
#   --profile acontext        Acontext memory distillation (port 8029)
#   --profile knowledge       CBM code graph (9749) + Graphify semantic graph (9750)
#   --profile decision-engine Decision Engine orchestrator (port 8001)
#
# Example: docker compose --profile scrapling --profile knowledge up -d

# ============================================================
# Traefik Reverse Proxy (profile: gateway)
# ============================================================
# Domain for Let's Encrypt SSL certificates.
DOMAIN=localhost
# Email for Let's Encrypt certificate notifications.
ACME_EMAIL=admin@example.com
# Kill-switch: off = Odysseus binds directly (current behavior).
# Set to "on" and start with: docker compose --profile gateway up -d
ODYSSEUS_TRAEFIK=off

# ============================================================
# Channel Gateway
# ============================================================
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ============================================================
# External MCP Services — Phase 4 (Scrapling, Kroki)
# ============================================================
# Scrapling — adaptive web scraper. Activate with:
#   docker compose --profile scrapling up -d
SCRAPLING_ENABLED=false

# Kroki — diagram rendering (Mermaid, PlantUML, GraphViz, 25+ formats).
# When on/1: POST /api/diagram returns SVG/PNG via local Docker kroki service.
# Default OFF — invariant "kill-switch OFF par défaut".
KROKI_ENABLED=off

# ============================================================
# Obsidian second-brain — Phase 8
# ============================================================
# Mount your Obsidian vault into the container at this path
# (or set to a host path when running outside Docker).
OBSIDIAN_VAULT_PATH=/obsidian-vault
# To expose read/search vault tools to the agent, set ODYSSEUS_OBSIDIAN_MCP=on
# (in the M3 orchestration section above). The vault write leg is handled by
# the native checkpoint bridge, not this server.

# Obsidian vault (chemin sur l'hôte). Monté en read-only dans le conteneur
# à /obsidian-vault. Adaptez ce chemin à votre machine.
# Exemples:
#   Linux/macOS:   OBSIDIAN_VAULT_PATH_HOST=~/Documents/vault-obsidian
#   Windows (Git Bash/MSYS2):  OBSIDIAN_VAULT_PATH_HOST=/c/Users/vous/Documents/vault-obsidian
#   Windows (PowerShell):      OBSIDIAN_VAULT_PATH_HOST=C:/Users/vous/Documents/vault-obsidian
OBSIDIAN_VAULT_PATH_HOST=~/Documents/vault-obsidian

# ============================================================
# Acontext memory pipeline — Phase 8
# ============================================================
# URL of the Acontext service (Docker Compose internal network).
# The service distills completed agent sessions into reusable SKILL.md files
# via LLM. Requires profile "acontext": docker compose --profile acontext up -d
ACONTEXT_URL=http://acontext:8029
ACONTEXT_ENABLED=false

# Auto-evolution — Phase 2. OFF by default: the live loop never triggers
# improvement research. When "on", after drift HIGH + autoeval REVERT, the
# system launches a deep research job to find better approaches.
ODYSSEUS_AUTOEVOLVE=on

# CodeBurn post-session analysis. OFF by default: the session-end loop never
# runs the codeburn CLI. When "on", codeburn reads session traces and feeds
# one-shot rate, waste patterns, and cost-vs-commits to the Observer.
# Requires: npm i -g codeburn (best-effort, degrades gracefully if missing).
ODYSSEUS_CODEBURN=off

# AgentSeal security probes. OFF by default: the session-end loop never runs
# agentseal. When "on", runs agentseal probe --ci post-session and feeds
# vulnerability findings to the Observer. Requires: pip install agentseal.
ODYSSEUS_AGENTSEAL=off

# LangFuse LLM tracing & observability dashboard. OFF by default: traces go to
# JSONL files only. When "on", structured traces (LLM calls, tool usage, token
# counts, costs, latency) are sent to the self-hosted LangFuse dashboard.
# Requires: docker compose --profile observability up -d
ODYSSEUS_LANGFUSE=off
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=lf-pub-...
# LANGFUSE_SECRET_KEY=lf-sec-...
# LANGFUSE_DB_PASSWORD=odysseus-langfuse
# LANGFUSE_NEXTAUTH_SECRET=odysseus-langfuse-nextauth-secret
# LANGFUSE_SALT=odysseus-langfuse-salt

# Live orchestration. OFF by default: the chat loop uses the simplified
# PhaseTracker (BUILD/PLAN only). When "on", activates the full CanonicalLoop
# with 7 phases (CLASSIFY→KNOW→PLAN→BUILD→QUALITY→AUTOEVAL→MEMORY_OBSERVE).
ODYSSEUS_LIVE_ORCHESTRATION=off

# Meilisearch full-text search. OFF by default: the search routes use
# SQLite LIKE queries (no fuzzy matching, no typo tolerance). When "on",
# full-text search across messages, notes, and documents uses Meilisearch
# (typo-tolerant, ranked, faceted). Requires: docker compose up meilisearch
ODYSSEUS_MEILISEARCH=off

# Meilisearch connection settings (used when ODYSSEUS_MEILISEARCH=on)
# MEILI_HOST=meilisearch
# MEILI_PORT=7700
# MEILI_MASTER_KEY=odysseus-meili-key

# Decision Engine — build context path for docker compose --profile decision-engine.
# Points to the ConfigOpenCodeNew repo (external). Use a relative or absolute path.
DECISION_ENGINE_PATH=../ConfigOpenCodeNew/decision-engine

# ── OPA Policy Engine ─────────────────────────────────────────────
# Open Policy Agent (CNCF, Apache 2.0). OFF by default: no OPA container,
# no Rego policy queries — tool access uses the YAML-based phase-lock.
# When ON: OPA validates every tool call and phase transition via Rego
# policies (config/policies/). Requires profile "security":
#   docker compose --profile security up -d opa
ODYSSEUS_OPA=off
# OPA endpoint URL. In Docker Compose, default is http://opa:8181.
# When running outside Docker, point to localhost:
ODYSSEUS_OPA_URL=http://127.0.0.1:8181

# ── Prefect Pipelines (M5) ────────────────────────────────────────
# OFF by default: the built-in task_scheduler handles scheduling.
# When "on", Prefect replaces task_scheduler for RAG reindex, memory
# cleanup, model updates, and backups. Requires:
#   docker compose --profile automation up -d prefect-server
ODYSSEUS_PREFECT=off

# Prefect server API URL. Default points to the Docker Compose service.
# For Prefect Cloud, set: https://app.prefect.cloud/api/accounts/<id>/workspaces/<id>
# PREFECT_API_URL=http://prefect-server:4200/api/

# ============================================================
# Docker Compose — UID/GID & API keys
# ============================================================

# User/group ID the container drops to before running uvicorn.
# 1000 is the default first user on most Linux installs. Override if yours differs.
# Find yours with:  id -u  /  id -g
# PUID=1000
# PGID=1000

# GID of the host's docker group (for Cookbook Docker socket access).
# Defaults: 963 (Debian), 999 (Ubuntu). Find yours with: getent group docker | cut -d: -f3
# DOCKER_GID=963

# HuggingFace token (for gated model downloads via Cookbook)
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Search API keys (at least one needed for web search to work)
# DATA_BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_PSE_CX=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# PROJECT.yaml manifest. OFF by default: the loop ignores per-project
# budgets, constraints, and autoeval config. When "on", budget_enforcer
# and autoeval read .planning/PROJECT.yaml at session start.

# ============================================================
# M6 — AgentOS SFD v3.0 100% Alignment Modules
# Core stable modules ON by default.
# Set to "off" to disable individual modules.
# ============================================================
ODYSSEUS_DURABLE_EXECUTION=on             # Exécution durable Custom SQLite
ODYSSEUS_PROVENANCE_MEMORY=on        # Mémoire avec [stated]/[observed]/[inferred]
ODYSSEUS_PREFERENCES=on              # Préférences utilisateur
ODYSSEUS_OUTPUT_ROUTER=on            # Sortie visuelle HTML/SVG inline + Kroki
ODYSSEUS_DATA_CLASSIFICATION=on      # Classification 5 niveaux rétention
ODYSSEUS_CONTENT_SECURITY=on         # Injection guard + output filter
ODYSSEUS_TOOL_DISCOVERY=on           # lu mais sans appelant (câblage INT-7 / Sprint 3)
